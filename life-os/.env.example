# Life OS — secrets live ONLY here (this file is the template; copy to .env).
# .env is gitignored. Never commit real tokens; never log them.

# Owner token — full access to the whole board (private + shared).
CFO_API_TOKEN=generate_a_long_random_secret

# Partner (Jahnavi) token — reaches ONLY /life and only shared items.
# MUST be a different secret from CFO_API_TOKEN. Generate fresh, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CFO_SHARE_TOKEN=generate_a_DIFFERENT_long_random_secret

# Public base URL used to build the partner share link (optional).
# If unset, the link is built from the incoming request's host.
LIFE_BASE_URL=

# Where the JSON store lives — mount a persistent volume here in production.
LIFE_STATE_DIR=data/state/life

# Port (containers usually inject PORT).
LIFE_PORT=8600
