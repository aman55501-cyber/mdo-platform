# Secrets — never commit
.env
.env.local
.env*.local

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.ruff_cache/
.pytest_cache/

# Database files — live on Railway volume, not in repo
*.db
*.sqlite

# Node / Next.js
mdo-app/node_modules/
mdo-app/.next/
mdo-app/out/
mdo-app/dist-electron/

# Claude / IDE
.claude/
.cursor/
.vscode/

# OS
.DS_Store
Thumbs.db

# VPN client profiles — contain private keys, never commit
vpn/*/client.ovpn
vpn/**/*.ovpn

# Execution audit log
shares_cfo/data/execution_audit.jsonl

# Generated state (snapshots + audit) — persisted via Docker volume
shares_cfo/data/state/

# Screener drop-zone: user's Premium exports + runtime caches (universe index,
# header-map cache) — data, never source. Keep only the README.
shares_cfo/data/screener/*
!shares_cfo/data/screener/README.md
