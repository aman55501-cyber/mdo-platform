# Business OS — secrets and config live ONLY here (never hard-coded, never logged).
# Copy to .env and fill in. .env is gitignored.

# --- Server ---
PORT=8600
LOG_LEVEL=INFO
# Where dataset JSON is persisted. In Docker this is the mounted volume.
BUSINESS_DATA_DIR=/data/state/business

# --- Phone alerts (all optional; wire whichever you use) ---
# ntfy: set a topic (and optionally a self-hosted server + token)
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ops agent thresholds (each passes through the number normaliser) ---
RECEIVABLE_AGE_DAYS=60
PROJECT_HORIZON_DAYS=7
COMPLIANCE_HORIZON_DAYS=10
