# HDFC Securities (legacy Vega single-account vars)
HDFC_API_KEY=your_hdfc_api_key
HDFC_API_SECRET=your_hdfc_api_secret
HDFC_REDIRECT_URL=http://localhost:8080/callback
HDFC_BASE_URL=https://developer.hdfcsec.com
HDFC_STATIC_IP=your.static.ip.address

# ======================================================================
# Shares CFO (read-only) — per-account credentials
# Pattern: HDFC_<KEY>_API_KEY / _API_SECRET / _ACCESS_TOKEN / _REDIRECT_URL / _CLIENT_CODE
# The ACCESS_TOKEN line is written automatically by scripts/hdfc_login.py — leave it blank.
# ----------------------------------------------------------------------
# Shared (all accounts)
HDFC_BASE_URL=https://developer.hdfcsec.com/oapi/v1
SHARES_CFO_USER_AGENT=shares-cfo/1.0
CFO_ACCOUNTS=HDFC1
# Angel needs your VPS public IP in request headers. Set it here to SKIP the auto-detect
# (a network call on a hot path) — recommended on the VPS. `curl -s https://api.ipify.org`
ANGEL_PUBLIC_IP=
# Real-time tick streaming via Angel's WebSocket feed (live LTP/OI on positions).
# On by default when Angel is logged in; set to 0 to force the slower REST polling.
CFO_WS_ENABLED=1
CFO_API_TOKEN=make_up_a_long_random_string
# Optional password screen for the web app. When set, opening the app asks for this
# password and only then loads (so the API token isn't carried in the URL). Blank = off.
CFO_PASSWORD=
# OPTIONAL — AI narrative on the deep-analysis briefs (the ✨ button + written take).
# The whole app works without it; leave blank to keep deep analysis structured-only.
ANTHROPIC_API_KEY=
CFO_LLM_MODEL=claude-sonnet-5
# OPTIONAL — Claude-assisted Screener column mapping. When a Premium export uses header
# text the static table doesn't know ("ROE %" vs "Return on equity", "Sub-Industry" vs
# "Industry"), the LLM maps the leftover HEADERS to fields (never data values; every
# header is validated against the real list; cached per export). On by default when
# ANTHROPIC_API_KEY is set; set to 0 to force pure static mapping.
CFO_SCREENER_LLM_MAP=1

# ======================================================================
# LIVE TRADING (execution) — every value defaults to the SAFE (off/zero) state.
# NOTHING can be placed until ALL caps for that segment are set. Check readiness
# any time with:  GET /execution/preflight   (names the exact missing item).
# ----------------------------------------------------------------------
# --- Master switch (equity). Off => no order of any kind leaves the building. ---
CFO_TRADING_ENABLED=false
# --- Equity caps (ALL required for equity orders; 0 = block) ---
CFO_MAX_QTY_PER_ORDER=0            # max units per single equity order
CFO_MAX_VALUE_PER_ORDER=0          # ₹ notional ceiling per equity order
CFO_ALLOWED_UNDERLYINGS=           # comma list, e.g. RELIANCE,TCS,INFY (empty = block all)
# --- Shared caps (apply to BOTH equity and F&O) ---
CFO_MAX_RISK_PER_TRADE=0           # ₹ max loss per bet (qty × |entry−stop|); 0 = block
CFO_MAX_ORDERS_PER_DAY=0           # kill count for the day across all segments
CFO_DAILY_LOSS_HALT=0              # ₹; auto-halt once day P&L ≤ −this. 0 = no halt

# --- F&O (derivatives) — a SEPARATE gate. Notional caps are meaningless here
#     (a NIFTY futures lot is ~₹19L notional but ~₹1.5L margin), so F&O is sized
#     in LOTS with premium/notional-shaped caps instead. ---
CFO_FNO_ENABLED=false              # dedicated derivatives switch (in ADDITION to the master switch)
CFO_FNO_ALLOWED_UNDERLYINGS=       # F&O whitelist, e.g. NIFTY,BANKNIFTY,RELIANCE (falls back to CFO_ALLOWED_UNDERLYINGS)
CFO_MAX_LOTS_PER_ORDER=0           # cap per F&O order, in LOTS (0 = block)
CFO_MAX_PREMIUM_PER_ORDER=0        # ₹ cash-outlay cap when BUYING options (0 = block option buys)
CFO_MAX_NOTIONAL_FNO=0             # ₹ notional cap for futures / short options (0 = skip this check)

# HDFC1 — Aman (personal), client code 4016900
HDFC_HDFC1_API_KEY=your_hdfc1_api_key
HDFC_HDFC1_API_SECRET=your_hdfc1_api_secret
HDFC_HDFC1_ACCESS_TOKEN=
HDFC_HDFC1_REDIRECT_URL=http://localhost:8080/callback
HDFC_HDFC1_CLIENT_CODE=4016900

# HDFC2..HDFC6 (Phase 3) and Angel (ANGEL_ANGEL1_*) go here later.

# xAI Grok
GROK_API_KEY=your_xai_api_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Strategy
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
RISK_PER_TRADE_PCT=2.0
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=5.0
TARGET_PCT=3.0
STOP_LOSS_PCT=1.5

# General
LOG_LEVEL=INFO
DB_PATH=vega_data.db
