# HDFC Securities (legacy Vega single-account vars)
HDFC_API_KEY=your_hdfc_api_key
HDFC_API_SECRET=your_hdfc_api_secret
HDFC_REDIRECT_URL=http://localhost:8080/callback
HDFC_BASE_URL=https://developer.hdfcsec.com
HDFC_STATIC_IP=your.static.ip.address

# ======================================================================
# Shares CFO (read-only) — per-account credentials
# Pattern: HDFC_<KEY>_API_KEY / _API_SECRET / _ACCESS_TOKEN / _REDIRECT_URL / _CLIENT_CODE
# The ACCESS_TOKEN line is written automatically by scripts/hdfc_login.py — leave it blank.
# ----------------------------------------------------------------------
# Shared (all accounts)
HDFC_BASE_URL=https://developer.hdfcsec.com/oapi/v1
SHARES_CFO_USER_AGENT=shares-cfo/1.0
CFO_ACCOUNTS=HDFC1
CFO_API_TOKEN=make_up_a_long_random_string

# HDFC1 — Aman (personal), client code 4016900
HDFC_HDFC1_API_KEY=your_hdfc1_api_key
HDFC_HDFC1_API_SECRET=your_hdfc1_api_secret
HDFC_HDFC1_ACCESS_TOKEN=
HDFC_HDFC1_REDIRECT_URL=http://localhost:8080/callback
HDFC_HDFC1_CLIENT_CODE=4016900

# HDFC2..HDFC6 (Phase 3) and Angel (ANGEL_ANGEL1_*) go here later.

# xAI Grok
GROK_API_KEY=your_xai_api_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Strategy
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
RISK_PER_TRADE_PCT=2.0
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=5.0
TARGET_PCT=3.0
STOP_LOSS_PCT=1.5

# General
LOG_LEVEL=INFO
DB_PATH=vega_data.db
