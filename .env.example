# HDFC Securities (legacy Vega single-account vars)
HDFC_API_KEY=your_hdfc_api_key
HDFC_API_SECRET=your_hdfc_api_secret
HDFC_REDIRECT_URL=http://localhost:8080/callback
# Vega's own base URL — it appends /api/v1 itself, so it must NOT share
# HDFC_BASE_URL with Shares CFO (which points at .../oapi/v1 below).
VEGA_HDFC_BASE_URL=https://developer.hdfcsec.com
HDFC_STATIC_IP=your.static.ip.address

# ======================================================================
# Shares CFO (read-only) — per-account credentials
# Pattern: HDFC_<KEY>_API_KEY / _API_SECRET / _ACCESS_TOKEN / _REDIRECT_URL / _CLIENT_CODE
# The ACCESS_TOKEN line is written automatically by scripts/hdfc_login.py — leave it blank.
# ----------------------------------------------------------------------
# Shared (all accounts)
HDFC_BASE_URL=https://developer.hdfcsec.com/oapi/v1
SHARES_CFO_USER_AGENT=shares-cfo/1.0
CFO_ACCOUNTS=HDFC1
# Angel needs your VPS public IP in request headers. Set it here to SKIP the auto-detect
# (a network call on a hot path) — recommended on the VPS. `curl -s https://api.ipify.org`
ANGEL_PUBLIC_IP=
# Real-time tick streaming via Angel's WebSocket feed (live LTP/OI on positions).
# On by default when Angel is logged in; set to 0 to force the slower REST polling.
CFO_WS_ENABLED=1
# CFO_API_TOKEN is defined once, in the Capital bridge section at the bottom —
# the same value authenticates Shares CFO and the MDO backend that reads it.
# Optional password screen for the web app. When set, opening the app asks for this
# password and only then loads (so the API token isn't carried in the URL). Blank = off.
CFO_PASSWORD=
# AI narrative on the deep-analysis briefs (the ✨ button + written take) uses
# ANTHROPIC_API_KEY, defined once in the MDO Brain section below. The whole app
# works without it; leave that blank to keep deep analysis structured-only.
CFO_LLM_MODEL=claude-sonnet-5
# OPTIONAL — Claude-assisted Screener column mapping. When a Premium export uses header
# text the static table doesn't know ("ROE %" vs "Return on equity", "Sub-Industry" vs
# "Industry"), the LLM maps the leftover HEADERS to fields (never data values; every
# header is validated against the real list; cached per export). On by default when
# ANTHROPIC_API_KEY is set; set to 0 to force pure static mapping.
CFO_SCREENER_LLM_MAP=1

# ======================================================================
# LIVE TRADING (execution) — every value defaults to the SAFE (off/zero) state.
# NOTHING can be placed until ALL caps for that segment are set. Check readiness
# any time with:  GET /execution/preflight   (names the exact missing item).
# ----------------------------------------------------------------------
# --- Master switch (equity). Off => no order of any kind leaves the building. ---
CFO_TRADING_ENABLED=false
# --- Equity caps (ALL required for equity orders; 0 = block) ---
CFO_MAX_QTY_PER_ORDER=0            # max units per single equity order
CFO_MAX_VALUE_PER_ORDER=0          # ₹ notional ceiling per equity order
CFO_ALLOWED_UNDERLYINGS=           # comma list, e.g. RELIANCE,TCS,INFY (empty = block all)
# --- Shared caps (apply to BOTH equity and F&O) ---
CFO_MAX_RISK_PER_TRADE=0           # ₹ max loss per bet (qty × |entry−stop|); 0 = block
CFO_MAX_ORDERS_PER_DAY=0           # kill count for the day across all segments
CFO_DAILY_LOSS_HALT=0              # ₹; auto-halt once day P&L ≤ −this. 0 = no halt

# --- F&O (derivatives) — a SEPARATE gate. Notional caps are meaningless here
#     (a NIFTY futures lot is ~₹19L notional but ~₹1.5L margin), so F&O is sized
#     in LOTS with premium/notional-shaped caps instead. ---
CFO_FNO_ENABLED=false              # dedicated derivatives switch (in ADDITION to the master switch)
CFO_FNO_ALLOWED_UNDERLYINGS=       # F&O whitelist, e.g. NIFTY,BANKNIFTY,RELIANCE (falls back to CFO_ALLOWED_UNDERLYINGS)
CFO_MAX_LOTS_PER_ORDER=0           # cap per F&O order, in LOTS (0 = block)
CFO_MAX_PREMIUM_PER_ORDER=0        # ₹ cash-outlay cap when BUYING options (0 = block option buys)
CFO_MAX_NOTIONAL_FNO=0             # ₹ notional cap for futures / short options (0 = skip this check)

# HDFC1 — Aman (personal), client code 4016900
HDFC_HDFC1_API_KEY=your_hdfc1_api_key
HDFC_HDFC1_API_SECRET=your_hdfc1_api_secret
HDFC_HDFC1_ACCESS_TOKEN=
HDFC_HDFC1_REDIRECT_URL=https://srv1641037.hstgr.cloud/hdfc/callback
HDFC_HDFC1_CLIENT_CODE=4016900

# HDFC2..HDFC6 (Phase 3) and Angel (ANGEL_ANGEL1_*) go here later.

# xAI Grok

# xAI Grok — API (billed per call, separate from the Grok app subscription).
# Used by the x-watch bot (real-time X/Twitter + web via x_search/web_search).
GROK_API_KEY=your_xai_api_key
GROK_MODEL=grok-4
# Approximate list price per 1M tokens, used only for the spend ledger — correct when xAI's page differs.
GROK_PRICE_IN_USD=3
GROK_PRICE_OUT_USD=15
# Locked door for outside agents to post tenders (Grok task, scraper, Gmail parser):
# POST /api/cos/tender-inbound with header X-Tender-Token. Long random string.
TENDER_INBOUND_TOKEN=

# MDO Brain (LLM layer) — Claude preferred, Grok used as fallback
ANTHROPIC_API_KEY=your_anthropic_api_key

# MCP server for the Claude app (phone/web). Set a long random string to enable;
# connector URL becomes http://<VPS_IP>:8501/mcp/<secret>/mcp
MDO_MCP_SECRET=

# Access password for the app + API. Set any strong passphrase; the app shows a
# lock screen once per device. Leave empty to disable protection (not advised).
MDO_AUTH_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Strategy
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
RISK_PER_TRADE_PCT=2.0
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=5.0
TARGET_PCT=3.0
STOP_LOSS_PCT=1.5

# General
LOG_LEVEL=INFO
DB_PATH=vega_data.db

# Deployment (docker compose on Hostinger VPS — see DEPLOY_HOSTINGER.md)
# URL the BROWSER uses to reach the backend. With the single-hostname Caddyfile this
# is just the domain — same origin as the app, so the browser calls /api/* on it:
# no CORS, no mixed content, and it survives an IP change.
NEXT_PUBLIC_API_URL=https://amanagrawal.cloud

# ── Capital bridge (Shares CFO — live broker sessions) ─────────────────────
# Shares CFO now runs as the `sharescfo` service inside THIS compose stack and
# holds authenticated sessions for HDFC1 (Aman), HDFC2 (Sudha), HDFC3 (Ashok)
# and ANGEL1 (Aditi). MDO reads through it instead of building a second broker
# auth path. Same network, so no `docker network connect` step is needed.
# CFO_API_TOKEN is the single shared secret: Shares CFO requires it on every
# request, and the MDO backend presents it. Make it long and random.
CFO_API_URL=http://sharescfo:8000
CFO_API_TOKEN=make_up_a_long_random_string

# ── Public hostname (Caddy — automatic HTTPS, see Caddyfile) ────────────────
# ONE hostname serves everything, routed by path:
#   /api/*  → MDO backend      /hdfc/* → Shares CFO (the OAuth callback)
#   /mcp/*  → MDO backend      /*      → the MDO app
# This must match the redirect URL registered at developer.hdfcsec.com —
# https://<DOMAIN>/hdfc/callback — or the daily broker login breaks silently.
DOMAIN=srv1641037.hstgr.cloud
# Extra hostnames served by the same Caddy block (space-separated). Needs an A record
# for each name pointing at this VPS. The dashboard's own API URL below must match the
# name Aman opens in the browser.
ALT_DOMAINS=amanagrawal.cloud www.amanagrawal.cloud
# Optional extra hostnames if you ever split the surfaces apart. Leave blank.
MDO_DOMAIN=
MDO_API_DOMAIN=
CFO_DOMAIN=
# Where MDO's own /api/hdfc/callback should hand a request token over to, if HDFC
# is ever pointed at the MDO backend instead. Leave set — the token is single-use,
# so it must be spent by Shares CFO, which is where the broker session lives.
CFO_PUBLIC_URL=https://srv1641037.hstgr.cloud

# ── Decision Feed (the one place decisions arrive) ─────────────────────────
# Public base URL of the MDO app. A critical finding pushes to your phone with a
# link to MDO_APP_URL/feed/<id> — the tap lands on the approve screen. Without it
# the push still carries the finding, just no one-tap link.
MDO_APP_URL=https://srv1641037.hstgr.cloud
# Cooldowns in minutes: how long the same finding stays quiet after interrupting.
MDO_FEED_COOLDOWN_CRITICAL=180
MDO_FEED_COOLDOWN_IMPORTANT=720
MDO_FEED_COOLDOWN_INFO=1440
# Undecided items drop off the feed after this long (hours).
MDO_FEED_EXPIRY_HOURS=168
# Money-moving actions NEVER execute from an approval tap while this is off.
# Turning it on is deliberate; broker guardrails (CFO_* caps above) still apply.
MDO_FEED_MONEY_ACTIONS=0
# Push channels — all optional, all best-effort, all get the same message.
# WhatsApp uses ALERT_WHATSAPP_TO + WA_BRIDGE_URL; these two add phone push:
CFO_NTFY_TOPIC=
CFO_TELEGRAM_BOT_TOKEN=
CFO_TELEGRAM_CHAT_ID=
# Where 🔴 alerts go on WhatsApp (your own number = a self-message).
ALERT_WHATSAPP_TO=

# ── Site networks over the VPN sidecars (accurate data at source) ───────────
# The vpn-hotel / vpn-vedanta containers each hold one OpenVPN tunnel plus an HTTP
# proxy on :8888. The backend reads site servers THROUGH those proxies; the VPS
# host routing table is never touched. Read-only — no writes to site systems.
HOTEL_PROXY_URL=http://vpn-hotel:8888
VEDANTA_PROXY_URL=http://vpn-vedanta:8888
MDO_SITE_TIMEOUT=12
# Tunnel liveness probes. Set each to a URL INSIDE that site's LAN that answers
# HTTP (the site gateway's login page is usually enough). Without a probe the
# system can only tell you the sidecar is alive, not that the tunnel is carrying.
HOTEL_PROBE_URL=
VEDANTA_PROBE_URL=
# Raw TCP forwards into a site LAN, for systems that do not speak HTTP. The hotel
# runs IDS Next FortuneNext, a SQL Server application, so its data is on 1433 —
# an HTTP proxy cannot carry that. Format: listen:host:port, comma separated.
# Fill in after the discovery scan finds the real address.
#   HOTEL_TCP_FORWARDS=1433:10.0.0.5:1433
HOTEL_TCP_FORWARDS=
VEDANTA_TCP_FORWARDS=
# What to read from each site, as JSON. Left empty the system reports "no sources
# configured" rather than guessing an address — fill it in after discovery
# (see docs/PLAN_VPN_SITE_ACCESS.md) or use site_sources.json. Example:
#   [{"site":"hotel","key":"occupancy","label":"Rooms sold",
#     "url":"http://10.0.0.20/api/stats","json_path":"rooms.occupied"}]
MDO_SITE_SOURCES=

# ── Chief of Staff ──────────────────────────────────────────────────────────
# Brain model for chat/WhatsApp (the CoS). Fable 5.1 is the most capable; set
# claude-opus-5-5 to halve cost. Bots on the VPS take their model from fleet.yaml.
BRAIN_MODEL=claude-fable-5-1
# Monthly API spend cap for the VPS bots, in rupees. ≥90% → bots drop to Haiku,
# 100% → bots pause and say so. Empty = no cap (not advised).
SPEND_CAP_INR_MONTH=10000
USD_INR=84
# Outbound channel: alert (self-message via the ops bridge, works today) |
# baileys (dedicated CoS number on its own bridge) | meta (WhatsApp Cloud API)
COS_CHANNEL=alert
ALERT_WHATSAPP_TO=917000512030
# Numbers allowed to talk to the CoS (comma list, digits with country code).
COS_ALLOWED_NUMBERS=917000512030
# baileys channel: the dedicated bridge + the number it delivers to
COS_WA_BRIDGE_URL=http://whatsapp-cos:3001
COS_WHATSAPP_TO=917000512030
# meta channel: from developers.facebook.com → WhatsApp → API setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
# Grok context pack — READ-ONLY. GET /api/grok/context?k=<this> (or header
# X-Grok-Context-Token) returns ≤6 KB of plain text that Aman's Grok subscription
# tasks open first: confirmed objective titles from agenda.yaml, the entity
# register, the tender lens (coal washing + RCR, margin first), the market lens
# (crude + global drivers, >80% conviction, never book a loss), what Grok already
# reported in the last 14 days (do not re-report), and the [GROK-TENDER] /
# [GROK-SINGHVI] table formats. Never carries chat text, phone numbers, tokens or
# bank data. Empty = the page answers 403 to everyone. Long random string; paste
# the same value into the Grok task prompt. Each fetch is audited; 60/hour max.
GROK_CONTEXT_TOKEN=
# Calendar feed — GET /api/calendar.ics?token=<this> is the iCalendar feed the
# phone subscribes to (compliance due dates, position expiries, the option
# alert note, the Las Vegas trip dates). Its own door, separate from the app
# key so the app key never travels in a calendar URL. Empty = the feed answers
# 403 to everyone. `bash deploy_vps.sh` generates it when empty and prints the
# full feed URL on its summary (DEPLOY_HOSTINGER.md §8b).
CALENDAR_TOKEN=
# ── Vault: Aman's private files on the VPS (memory/, finance/) ──────────────
# Lives in the Docker data volume at /data/vault — never in the repo. Reached
# only via /api/vault/* with this token (separate from MDO_AUTH_TOKEN so the
# app key cannot read the finance workbook). Long random string. Use the HTTPS
# domain for MDO_SELF_URL so the token never travels in clear.
VAULT_TOKEN=
# Passphrase for the weekly AES-256 bundle of the vault + the latest database
# snapshots (/data/backups/weekly-YYYYMMDD.tar.enc, DEPLOY_HOSTINGER.md §10).
# Without it the bundle is skipped and housekeeping says so every week. Keep a
# copy of this passphrase OFF the VPS — a bundle without it is noise.
VAULT_BACKUP_PASSPHRASE=
# Housekeeping retention — see mdo_housekeeping.py / DEPLOY_HOSTINGER.md §10
HK_KEEP_REPORT_DAYS=60
HK_KEEP_WA_DAYS=90
HK_KEEP_DAILY_SNAPSHOTS=14
HK_KEEP_WEEKLY_BUNDLES=8

# ── WhatsApp bridges (Baileys) ──────────────────────────────────────────────
# Each bridge forwards EVERY chat on its phone — groups and 1:1 DMs, incoming
# and Aman's own replies — to the backend, which classifies business vs
# personal and decides what to store. Only status/broadcast/newsletter traffic
# is dropped at the bridge.
# WA_ACCOUNT tags each forwarded message with the phone it came from. Set per
# service in docker-compose.yml (whatsapp=1, whatsapp2=2); the default is 1.
WA_ACCOUNT=1
# all (default) = ingest every group; list = only WATCHED_GROUPS in index.js.
# Never applies to DMs.
WA_WATCH_MODE=all

# ── WhatsApp Intelligence (mdo_wa_intel.py) ─────────────────────────────────
# Both phones' chats (groups + DMs) arrive at /api/whatsapp/message. Each chat is
# classified business | personal | unclear: personal chats store NOTHING and their
# history is deleted on the verdict; unclear chats wait in quarantine for the
# wa-classifier bot (Haiku, every 2h) or Aman's reply. Business chats feed the
# wa-intel bot (signals with evidence ids) and the Sunday business-pulse.
# Set to 0 to switch the gate off (every message is stored, legacy behaviour).
WA_INTEL_ENABLED=1

# ── Vision (reads photos posted in WhatsApp) ────────────────────────────────
# ~27% of group traffic is images — weighbridge slips, dispatch tallies, hotel
# registers. Uses ANTHROPIC_API_KEY. Set VISION_ENABLED=0 to switch off.
VISION_ENABLED=1
VISION_MODEL=claude-sonnet-5
# Comma list matched against group names (substring, punctuation-insensitive).
# Use * to process every group's images — costs more, mostly noise.
VISION_GROUPS=daily sales report,night report,dsr,rake,dispatch,weighbridge,w/b,loading,loader,machine,civil,washery,report,accounts,payment,purchase,store

# WhatsApp intel: a receivable is red once it is this many days past due (Aman, chat 2026-10-09)
RECEIVABLE_OVERDUE_DAYS=30

# levels-alert bot (Aman's share buy/sell list): where prices come from.
# unset/yahoo = Yahoo Finance over urllib (no key); none = fetch nothing (every ltp n/a);
# an http(s) URL = custom JSON source, "?symbols=TCS,INFY" appended, reply {"TCS": 3612.5, ...}
LEVELS_PRICE_SOURCE=yahoo

# share-master-daily bot (Aman, chat 2026-10-09): the master share workbook.
# MAUSAJI_CHAT: the WhatsApp chat/contact whose calls go into the "Mausaji Calls" tab — matched
# case-insensitively on the chat display name across both WA accounts. Aman confirmed the chat is
# named exactly "Bantu Mausaji", which is the code default, so no edit is needed here.
MAUSAJI_CHAT=Bantu Mausaji
# SHARESCFO_URL: where the Portfolio tab reads broker holdings (Shares CFO /portfolio). Defaults to
# CFO_API_URL above, then http://sharescfo:8000 inside compose; CFO_API_TOKEN is the token.
# SHARESCFO_URL=http://sharescfo:8000

# wa-sweep bot (Aman, chat 2026-10-09): rule-based sweep of WhatsApp, zero LLM spend.
# WA_SWEEP_CHATS: the chats watched, semicolon-separated, matched case-insensitively (exact or contained in
# the chat name, both phones). The Mausaji chat (MAUSAJI_CHAT above) is the shares chat; the rest are ops.
# Aman's list, 2026-10-09 (AMAN_PENDING A13) — this is the code default, so no edit is needed here.
WA_SWEEP_CHATS=Bantu Mausaji;Vedanta Daily Report;Washery Civil Update;Ans Management;VWLR Indent Planning;Core Group
# WA_SWEEP_GROUPS: an extra matcher — a regex over GROUP names (case-insensitive). The daily 21:00 IST line
# lists what matched so the set can be corrected here.
WA_SWEEP_GROUPS=washery|siding|hotel|ans|vwlr|rake|plant|site|loader|dispatch
# WA_SWEEP_IDLE_HOURS: an ops chat with no message for more than this many hours inside 08:00–20:00 IST is
# flagged once per silence episode and pushed at once (Aman, 2026-10-09: "more than 1 hour is intolerable").
WA_SWEEP_IDLE_HOURS=1

# mail-reader bot (Aman, chat 2026-10-09, AMAN_PENDING A26 C1): Gmail over IMAP (SSL), rule-based, zero LLM spend.
# GMAIL_IMAP_USER is the mailbox (aman.55501@gmail.com); GMAIL_APP_PASSWORD is a Google App Password (Google
# Account → Security → 2-Step Verification → App passwords), NOT the account password. Both are read on the VPS
# only, never printed: the heartbeat says "IMAP ok" / "IMAP not configured" / "IMAP login failed: <reason>".
GMAIL_IMAP_USER=
GMAIL_APP_PASSWORD=
# Defaults in code: GMAIL_IMAP_HOST=imap.gmail.com, MAIL_READER_FOLDER=INBOX. Override only for another mailbox.
GMAIL_IMAP_HOST=imap.gmail.com
MAIL_READER_FOLDER=INBOX

# tenders-direct bot (CoS brief 2026-10-09): public tender listings read from SECL, SECL e-tenders (NIC), Coal India,
# NTPC, the CPP portal and MSTC — no login, no API key, zero LLM spend. TENDERS_KEYWORDS: semicolon-separated words
# matched (case-insensitively) in a tender's title or organisation; the default is the code default, so no edit is
# needed. TENDERS_MIN_VALUE_CR: a stated value below this (₹ crore) is not a match; 0 = no floor; an unstated value
# never disqualifies. TENDERS_SITES_OFF: comma-separated site keys to skip (secl, secl-etender, coalindia, ntpc,
# eprocure, mstc), e.g. a portal that keeps answering 403.
TENDERS_KEYWORDS=washery;washing;beneficiation;RCR;road cum rail;coal transportation;coal loading;rake loading;siding;surface transport;crushing;overburden
TENDERS_MIN_VALUE_CR=0
TENDERS_SITES_OFF=

# voice bot (CoS brief 2026-10-09): WhatsApp voice notes transcribed on the VPS with faster-whisper (CPU, int8), no
# API. VOICE_MODEL: small (default; ~460 MB, downloaded once into /data/whisper-models) or base if the VPS is slow.
# VOICE_MAX_PER_RUN / VOICE_BUDGET_S: clips per 10-minute run and the time box in seconds. VOICE_MAX_MB: the largest
# clip the backend accepts. Bridge side: WA_AUDIO_FORWARD=0 stops the bridges forwarding audio; WA_AUDIO_MAX_BYTES caps
# the download (default 16 MB). Defaults are the code defaults — no edit is needed.
VOICE_MODEL=small
VOICE_MAX_PER_RUN=20
VOICE_BUDGET_S=480
VOICE_MAX_MB=20
WA_AUDIO_FORWARD=1
