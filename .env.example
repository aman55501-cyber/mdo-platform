# HDFC Securities
HDFC_API_KEY=your_hdfc_api_key
HDFC_API_SECRET=your_hdfc_api_secret
HDFC_REDIRECT_URL=http://localhost:8080/callback
HDFC_BASE_URL=https://developer.hdfcsec.com
HDFC_STATIC_IP=your.static.ip.address

# xAI Grok — API (billed per call, separate from the Grok app subscription).
# Used by the x-watch bot (real-time X/Twitter + web via x_search/web_search).
GROK_API_KEY=your_xai_api_key
GROK_MODEL=grok-4
# Approximate list price per 1M tokens, used only for the spend ledger — correct when xAI's page differs.
GROK_PRICE_IN_USD=3
GROK_PRICE_OUT_USD=15
# Locked door for outside agents to post tenders (Grok task, scraper, Gmail parser):
# POST /api/cos/tender-inbound with header X-Tender-Token. Long random string.
TENDER_INBOUND_TOKEN=

# MDO Brain (LLM layer) — Claude preferred, Grok used as fallback
ANTHROPIC_API_KEY=your_anthropic_api_key

# MCP server for the Claude app (phone/web). Set a long random string to enable;
# connector URL becomes http://<VPS_IP>:8501/mcp/<secret>/mcp
MDO_MCP_SECRET=

# Access password for the app + API. Set any strong passphrase; the app shows a
# lock screen once per device. Leave empty to disable protection (not advised).
MDO_AUTH_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Strategy
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
RISK_PER_TRADE_PCT=2.0
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=5.0
TARGET_PCT=3.0
STOP_LOSS_PCT=1.5

# General
LOG_LEVEL=INFO
DB_PATH=vega_data.db

# Deployment (docker compose on Hostinger VPS — see DEPLOY_HOSTINGER.md)
# URL the BROWSER uses to reach the backend: http://<VPS_IP>:8501 or https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8501

# ── Capital bridge (sharecfo — live broker sessions) ────────────────────────
# The sharecfo stack on this VPS holds authenticated sessions for HDFC1 (Aman),
# HDFC2 (Sudha), HDFC3 (Ashok) and ANGEL1 (Aditi). MDO reads through it instead
# of building a second broker auth path. Copy CFO_API_TOKEN from
# /docker/sharecfo/.env, and join the networks once:
#   docker network connect sharecfo_default mdo-platform-backend-1
CFO_API_URL=http://sharescfo:8000
CFO_API_TOKEN=

# ── Chief of Staff ──────────────────────────────────────────────────────────
# Brain model for chat/WhatsApp (the CoS). Fable 5.1 is the most capable; set
# claude-opus-5-5 to halve cost. Bots on the VPS take their model from fleet.yaml.
BRAIN_MODEL=claude-fable-5-1
# Monthly API spend cap for the VPS bots, in rupees. ≥90% → bots drop to Haiku,
# 100% → bots pause and say so. Empty = no cap (not advised).
SPEND_CAP_INR_MONTH=10000
USD_INR=84
# Outbound channel: alert (self-message via the ops bridge, works today) |
# baileys (dedicated CoS number on its own bridge) | meta (WhatsApp Cloud API)
COS_CHANNEL=alert
ALERT_WHATSAPP_TO=917000512030
# Numbers allowed to talk to the CoS (comma list, digits with country code).
COS_ALLOWED_NUMBERS=917000512030
# baileys channel: the dedicated bridge + the number it delivers to
COS_WA_BRIDGE_URL=http://whatsapp-cos:3001
COS_WHATSAPP_TO=917000512030
# meta channel: from developers.facebook.com → WhatsApp → API setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
# ── Vault: Aman's private files on the VPS (memory/, finance/) ──────────────
# Lives in the Docker data volume at /data/vault — never in the repo. Reached
# only via /api/vault/* with this token (separate from MDO_AUTH_TOKEN so the
# app key cannot read the finance workbook). Long random string. Use the HTTPS
# domain for MDO_SELF_URL so the token never travels in clear.
VAULT_TOKEN=
# Passphrase for the weekly AES-256 backup of the vault (archive/vault-*.tar.gz.enc).
# Without it the backup is skipped and housekeeping says so every week.
VAULT_BACKUP_PASSPHRASE=
# Housekeeping retention (days) — see mdo_housekeeping.py
HK_KEEP_REPORT_DAYS=60
HK_KEEP_WA_DAYS=90

# ── Vision (reads photos posted in WhatsApp) ────────────────────────────────
# ~27% of group traffic is images — weighbridge slips, dispatch tallies, hotel
# registers. Uses ANTHROPIC_API_KEY. Set VISION_ENABLED=0 to switch off.
VISION_ENABLED=1
VISION_MODEL=claude-sonnet-5
# Comma list matched against group names (substring, punctuation-insensitive).
# Use * to process every group's images — costs more, mostly noise.
VISION_GROUPS=daily sales report,night report,dsr,rake,dispatch,weighbridge,w/b,loading,loader,machine,civil,washery,report,accounts,payment,purchase,store
